# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.

# Proveedor del modelo: openai | gemini | simulado (simulado = guion determinista, sin clave)
LLM_PROVIDER=openai

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING=none

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.8-flash
# Nivel de razonamiento: MINIMAL | LOW | MEDIUM | HIGH
GEMINI_THINKING=LOW
# Opción A: API key de Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opción B: Vertex AI con credenciales de Google Cloud (ADC o cuenta de servicio), sin clave.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# ── Límites de costo y robustez ─────────────────────────────────────────────
MAX_ITERACIONES=25
MAX_TOKENS_SESION=1000000
LLM_TIMEOUT_MS=60000

PORT=8080
